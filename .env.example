APP_NAME=assembly
SPRING_PROFILES_ACTIVE=local

MAIN_DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
MAIN_DB_JDBC_URL=jdbc:mysql://localhost:3306/maindb?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MAIN_DB_USERNAME=root
MAIN_DB_PASSWORD=root
MAIN_DB_MAXIMUM_POOL_SIZE=10
MAIN_DB_MINIMUM_IDLE=2
MAIN_DB_POOL_NAME=main-db-pool

SAMPLE_DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SAMPLE_DB_JDBC_URL=jdbc:mysql://localhost:3306/sampledb?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SAMPLE_DB_USERNAME=root
SAMPLE_DB_PASSWORD=root
SAMPLE_DB_MAXIMUM_POOL_SIZE=5
SAMPLE_DB_MINIMUM_IDLE=1
SAMPLE_DB_POOL_NAME=sample-db-pool

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=3s
REDIS_CACHE_TTL=10m

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=assembly-local
KAFKA_AUTO_OFFSET_RESET=earliest

OPENSEARCH_SCHEME=http
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200

LOG_PATH=logs/local

JWT_SECRET_KEY=assembly-service-local-jwt-secret-key-must-be-at-least-32-bytes
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000
