APP_NAME=assembly
SPRING_PROFILES_ACTIVE=local

MAIN_DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
MAIN_DB_JDBC_URL=jdbc:mysql://127.0.0.1:13306/maindb?serverTimezone=Asia/Seoul&useUnicode=true&characterEncoding=UTF-8
MAIN_DB_USERNAME=admin
MAIN_DB_PASSWORD=
MAIN_DB_MAXIMUM_POOL_SIZE=10
MAIN_DB_MINIMUM_IDLE=2
MAIN_DB_POOL_NAME=main-db-pool

SAMPLE_DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SAMPLE_DB_JDBC_URL=jdbc:mysql://127.0.0.1:13306/sampledb?serverTimezone=Asia/Seoul&useUnicode=true&characterEncoding=UTF-8
SAMPLE_DB_USERNAME=admin
SAMPLE_DB_PASSWORD=
SAMPLE_DB_MAXIMUM_POOL_SIZE=5
SAMPLE_DB_MINIMUM_IDLE=1
SAMPLE_DB_POOL_NAME=sample-db-pool

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=3s
REDIS_CACHE_TTL=10m

KAFKA_BOOTSTRAP_SERVERS=localhost:9098
MSK_BOOTSTRAP_SERVERS=localhost:9098
KAFKA_GROUP_ID=assembly-group
KAFKA_AUTO_OFFSET_RESET=earliest
# false로 설정하면 Producer/Admin은 유지하고 @KafkaListener Consumer만 중지합니다.
KAFKA_LISTENERS_ENABLED=true
# SampleDB 미전송 이벤트 자동 재생 Scheduler는 기본적으로 비활성화합니다.
KAFKA_REPLAY_SCHEDULER_ENABLED=false
KAFKA_REPLAY_FIXED_DELAY_MS=5000
KAFKA_REPLAY_BATCH_SIZE=10

# local Kafka
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_JAAS_CONFIG=
KAFKA_SASL_CALLBACK_HANDLER_CLASS=

# AWS MSK IAM 사용 시 위 인증 설정을 아래 값으로 변경합니다.
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=AWS_MSK_IAM
# KAFKA_SASL_JAAS_CONFIG=software.amazon.msk.auth.iam.IAMLoginModule required;
# KAFKA_SASL_CALLBACK_HANDLER_CLASS=software.amazon.msk.auth.iam.IAMClientCallbackHandler
# AWS 자격증명은 정적 Access Key 대신 EKS Pod Identity 또는 IRSA를 사용합니다.

OPENSEARCH_SCHEME=http
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200

LOG_PATH=logs/local

JWT_SECRET_KEY=
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000
